{
  "compilerOptions": {
    "target": "ESNext",
    "module": "CommonJS",
    "lib": ["ESNext"],
    "strict": false,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "moduleResolution": "node",
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "rootDir": "."
  },
  "include": [
    "src/index.d.ts",
    "src/system1/index.d.ts",
    "src/cli.js",
    "src/commands/**/*.js",
    "src/utils/**/*.js",
    "src/browser/**/*.js",
    "src/system1/**/*.js",
    "bin/proxy-server.js"
  ],
  "exclude": ["node_modules", "dist", "target", "coverage", "test", "tests", ".agent", "scripts"]
}
