{
  "mcpServers": {
    "tribunal-kit": {
      "command": "node",
      "args": [".agent/scripts/mcp_server.js"],
      "env": { "NODE_ENV": "production" }
    },
    "context7": {
      "command": "npx",
      "args": ["@upstash/context7-mcp@1.0.1", "--api-key", "YOUR_CONTEXT7_API_KEY"]
    },
    "shadcn": {
      "command": "npx",
      "args": ["shadcn@2.1.8", "mcp"]
    }
  }
}
